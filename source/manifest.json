{
    "manifest_version": 2,
    "name": "TriliumClipper",
    "description": "A Thunderbird extension to clip messages to the Trilium Notes application.",
    "version": "1.1.0",
    
    "author": "0xBismarck",
    "browser_specific_settings": {
        "gecko": {
            "id": "TriliumClipper@TriliumNext.com",
            "strict_min_version": "121.0",
            "strict_max_version": "155.*"
        }
    },
    "message_display_action": {
        "default_title": "Trilium",
        "default_icon": "images/triliumnext-icon-32px.png"
    },
    "options_ui": {
        "page": "options/options.html",
        "browser_style": true,
        "open_in_tab": true
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "experiment_apis": {
        "NativePdf": {
            "schema": "api/NativePdf/schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["NativePdf"]],
                "script": "api/NativePdf/implementation.js"
            }
        }
    },
    "permissions": [
        "messagesModify",
        "messagesRead",
        "messagesTagsList",
        "storage",
        "menus"
    ],
    "optional_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "64": "images/triliumnext-icon-64px.png",
        "48": "images/triliumnext-icon-48px.png",
        "32": "images/triliumnext-icon-32px.png",
        "16": "images/triliumnext-icon-16px.png"
    }
}